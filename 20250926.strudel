samples({
  amen: '30_cat_&_hat.wav',
  pad: 'setback_beats32_bpm160.wav',
}, 'https://schollz.com/limewax/');
// 

setCps(160/60/4)

$: s("amen/8").fit()
  .scrub(irand(32).div(64).seg(8)
  .rib("<5 21>",2)
  )
  .almostNever(ply("2 | 4 | 3"))
  .gain(0.2)
  .duck("2:3:4").duckdepth(0.3)
  ._scope()

$pad: s("pad/8").fit()
  .scrub(irand(16).div(64).seg(8)
  .rib("<1 2 3 4>",1)
  )
  .room(0.9).roomsize(0.2)
  .almostNever(ply("2 | 4 | 3"))
  .gain(0.5)
  ._scope()

$: note("<a1@2 g1@2 f1@2 d2 c1>")
   .struct("1@5 1@3").lpenv(7).lpa(2)
   .seg(1).s("supersaw").lpf(200).orbit(2)
  .gain(2)
   ._scope()

